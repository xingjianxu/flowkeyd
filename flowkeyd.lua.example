-- flowkeyd 示例配置（Lua）
--
-- 把这个文件复制到默认位置，或直接照着改：
--   %USERPROFILE%\.config\flowkeyd\config.lua
-- 也可以显式指定：  flowkeyd --config C:\tools\flowkeyd.lua
--
-- 只校验不运行：  flowkeyd --check  --config flowkeyd.lua.example
-- 列出解析结果：  flowkeyd --list   --config flowkeyd.lua.example
-- 列出可用按键：  flowkeyd --list-keys
--
-- =============================================================================
-- 这是一段**真正的 Lua 脚本**，不是「换了语法的 TOML」：可以算表达式、写循环、
-- 调用标准库（`os.getenv`、`string.format`……）。它会被 flowkeyd 以你的权限执行，
-- 所以别运行来路不明的配置。
--
-- 配置的两种写法，可以混用：
--
--   1) 命令式（本文件用的就是这种）：调用 hotkey{} / remap{} / settings{} /
--      window_rule{} / app{}
--         for i = 1, 3 do hotkey{ keys = "Win+F" .. i, action = desktop(i) } end
--
--   2) 声明式：直接 return 一张表，字段里的条目排在脚本体注册的条目之后
--         return {
--           settings     = { swallow = true },
--           hotkeys      = { { keys = "Ctrl+Alt+t", action = run("wt.exe") } },
--           remaps       = { { from = "CapsLock", to = "Esc" } },
--           window_rules = { { process = "wezterm", monitor = 2 } },
--           apps         = { { process = "code", window = { monitor = 2 } } },
--         }
--
-- 动作可以是表、动作构造器（`run()` / `send()` / `volume()` …），或者简写字符串
-- （"send:^{c}"、"open:https://…"、"desktop:2"、"reload"）。**不接受 Lua 函数**：
-- 钩子回调与工作线程只执行已经校验过的声明式动作。
--
-- 两个 Lua 语言本身的坑：
--
--   * `repeat` 是 Lua 关键字，写不成 `hotkey{ repeat = true }`（语法错误）。
--     配置里请用 `repeatable = true`，或者 `["repeat"] = true`。
--   * 字符串里的反斜杠要转义，Windows 路径最省事的写法是长字符串：
--         program = [[C:\tools\my app\app.exe]]
--     写成 '单引号' 或 "双引号" 时反斜杠必须加倍：'C:\\tools\\app.exe'。

-- =============================================================================
-- 全局设置
-- =============================================================================
settings{
  -- trace | debug | info | warn | error | off （--log-level 会覆盖这里）
  log_level = "info",

  -- 默认行为：快捷键是否把它匹配到的按键对前台应用隐藏。
  -- 除非快捷键以 `~` 开头，否则 AutoHotkey 就是这么做的。
  swallow = true,

  -- false：按住 Alt 时 "Ctrl+h" 依然会触发（AutoHotkey 行为）。
  -- true： 修饰键集合必须完全一致。
  exact_modifiers = false,

  -- 执行 `send`/`type` 动作前先松开用户按住的修饰键，
  -- 这样 Ctrl+Alt+t -> send("^{c}") 真的会发出 Ctrl+c，而不是 Ctrl+Alt+c。
  release_modifiers = true,

  -- 长按重复的默认参数，供 `trigger = "repeat"` / `repeatable = true` 使用。
  repeat_interval_ms = 50,
  repeat_delay_ms = 400,

  -- 引擎定时器的运行频率（用于驱动重复）。
  tick_ms = 15,

  -- 按键注入后端：
  --   auto   —— 运行时探测通过时优先使用 win32u!NtUserSendInput
  --   user32 —— 始终使用已公开的 user32!SendInput
  --   ntuser —— 强制要求未公开的那条路径（失败时回退并给出警告）
  input_backend = "auto",

  -- 另一个实例已在使用同一配置文件时拒绝启动。
  single_instance = true,

  -- 守护进程模式启动时，若当前没有管理员权限就自动以管理员身份重启
  -- （会弹 UAC；`--no-elevate` 或 false 可以关掉）。
  -- 提权后的好处：动作可以驱动提权进程的窗口（否则会被 UIPI 拦下）。
  elevate = true,
}

-- =============================================================================
-- 快捷键
-- =============================================================================
-- keys       一个和弦，或一组和弦。
--            "Ctrl+Alt+t"、"^!t"（AutoHotkey 语法：^ Ctrl、! Alt、+ Shift、
--            # Win）、"~F4"（~ 表示放行原始按键）、"*F1"（* 表示即使额外
--            按住了其它修饰键也触发）。
--            `Numpad*` 指小键盘上的键，与主键盘的同名键是不同的键：
--            `NumpadSub` 是小键盘的 `-`（主键盘那个是 `Minus`），
--            `NumpadAdd` 是小键盘的 `+`（主键盘那个要 Shift，是 `Equal`），
--            `NumpadEnter` 也不是主键盘的 `Enter`。完整名单见 `--list-keys`。
-- trigger    何时触发。
--              press   （默认）按下即触发，而且只触发一次；
--                      被吞掉的 Win/Alt 和弦也是如此，不等修饰键抬起。
--              release 抬起时才触发。
--              repeat  按下即触发，之后按住期间重复。
-- action     按下时运行。`press` 和 `on_press` 是它的别名。
-- on_release 松开时运行。
-- repeatable true，或 { interval_ms = 40, delay_ms = 300 }；等价于
--            trigger = "repeat"。名字不叫 `repeat`，因为那是 Lua 关键字。
-- swallow    为这个快捷键覆盖 settings.swallow。
-- enabled    false 表示忽略这条（调试时很方便）。
-- comment    自由文本，`--list` 会显示出来。
--
-- 动作列表在**工作线程**上自上而下执行，因此慢动作不会拖住键盘钩子。
-- 列表写成 Lua 的数组即可：action = { send("^{c}"), notify("copied") }。

hotkey{
  name = "terminal",
  comment = "Ctrl+Alt+t 在当前目录打开 Windows Terminal",
  keys = "Ctrl+Alt+t",
  action = run("wt.exe", { "-w", "0" }),
}

hotkey{
  name = "explorer-here",
  keys = "Ctrl+Alt+e",
  action = run("explorer.exe", { "." }, { show = "normal" }),
}

hotkey{
  name = "screenshot-region",
  comment = "Win+Shift+s 是系统截图工具；这里演示如何串联多个动作",
  keys = "Ctrl+Alt+s",
  action = {
    send("#+{s}"),
    notify("Snipping", "Select the region to copy"),
  },
}

-- 复制当前选中内容、转成大写、再粘贴回去。{selection} 会合成一次 Ctrl+c
-- 并等待剪贴板。
hotkey{
  name = "uppercase-selection",
  keys = "Ctrl+Alt+u",
  action = {
    clipboard("set", { text = "{selection}" }),
    run("cmd.exe", { "/c", "echo not-a-real-example" }),
    notify("Selection", "{clipboard}"),
  },
}

-- 运行一条 shell 命令并等待它结束。
hotkey{
  name = "git-status",
  keys = "Ctrl+Alt+g",
  action = run("git status --short", { shell = true, wait = true }),
}

-- 打开一个常用位置（`[[...]]` 是 Lua 的长字符串：反斜杠不用转义）。
hotkey{
  name = "open-projects",
  keys = "Ctrl+Alt+p",
  action = open([[%USERPROFILE%\source]]),
}

-- 动作也可以用简写字符串。可用的前缀：run: send: type: open: notify:
-- desktop: volume: media: clipboard: window: power:，以及裸关键字 reload / quit / none。
hotkey{
  name = "open-docs",
  keys = "Ctrl+Alt+d",
  action = "open:https://learn.microsoft.com/windows/win32/winmsg/lowlevelkeyboardproc",
}

-- 用 Unicode 注入输入字面字符串（与键盘布局无关）。
hotkey{
  name = "type-signature",
  keys = "Ctrl+Alt+i",
  action = type_text("Best regards,\n{USERPROFILE}"),
}

-- 吞掉 CapsLock，并在它此前意外开启时将其关闭，再发送 Ctrl+Space。
hotkey{
  name = "capslock-ctrl-space",
  keys = "CapsLock",
  action = {
    caps_lock("off"),
    send("^{Space}"),
  },
}

-- 媒体与音量。`volume` 使用 Core Audio，因此它对默认输出设备的改动
-- 与 Windows 音量合成器完全一致。
hotkey{
  name = "volume-up",
  keys = "Ctrl+Alt+Up",
  repeatable = { interval_ms = 60, delay_ms = 250 },
  action = volume("up", { step = 2 }),
}

hotkey{
  name = "volume-down",
  keys = "Ctrl+Alt+Down",
  trigger = "repeat",
  action = volume("down", { step = 2 }),
}

hotkey{
  name = "mute",
  keys = "Ctrl+Alt+m",
  action = volume("toggle"),
}

hotkey{
  name = "volume-50",
  keys = "Ctrl+Alt+0",
  action = volume("set", { level = 50 }),
}

-- 小键盘上的 `-` / `+` / `Enter` 直接控制音量——不开修饰键、一只手就够，
-- 而且它们与主键盘上的 `-` / `=` / `Enter` 是完全不同的键：
-- `NumpadSub` / `NumpadAdd` 是 `VK_SUBTRACT` / `VK_ADD`（`+` 在小键盘上
-- 不需要 Shift，所以它不可能是主键盘的 `Equal`），而小键盘的 Enter 与主键盘的
-- Enter 共用 `VK_RETURN`，flowkeyd 靠 Windows 的扩展键标志区分它们。
-- 这三个键的 `VK` 与 `NumLock` 无关（NumLock 只影响字符翻译），
-- 所以 NumLock 开着或关着都一样能用。
--
-- 一个和弦里只能有一个按键（其余片段必须是修饰键），所以
-- `keys = "NumpadSub+NumpadAdd"` 这种「两个普通键一起按」是**不支持**的：
-- `--check` 会报 `` `NumpadSub` in chord ... is not a modifier ``，静音请用
-- 修饰键组合（如 `Ctrl+NumpadAdd`）或下面这样换一个独立的键。
hotkey{
  name = "numpad-volume-down",
  comment = "小键盘 -：音量降低（按住连续降）",
  keys = "NumpadSub",
  repeatable = { interval_ms = 60, delay_ms = 250 },
  action = volume("down", { step = 2 }),
}

hotkey{
  name = "numpad-volume-up",
  comment = "小键盘 +：音量提高（按住连续升）",
  keys = "NumpadAdd",
  repeatable = { interval_ms = 60, delay_ms = 250 },
  action = volume("up", { step = 2 }),
}

hotkey{
  name = "numpad-mute",
  comment = "小键盘 Enter：静音开关",
  keys = "NumpadEnter",
  action = volume("toggle"),
}

hotkey{
  name = "play-pause",
  keys = "Ctrl+Alt+Space",
  action = media("play_pause"),
}

hotkey{
  name = "next-track",
  keys = "Ctrl+Alt+Right",
  action = media("next"),
}

-- 窗口管理。
--
-- 动画默认关：flowkeyd 触发的状态变化不播放 DWM 的过渡（最小化不再“缩”到任务栏、
-- 还原也不再“长”出来）。用的是按窗口的 `DWMWA_TRANSITIONS_FORCEDISABLED`，
-- 不会改系统里“最小化/最大化时播放动画”那个全局设置，也不影响别的程序。
-- 想让某一条绑定保留动画就写 `animate = true`。
hotkey{
  name = "maximize",
  keys = "Ctrl+Alt+f",
  comment = "最大化（这一条保留系统动画，作为 animate = true 的例子）",
  action = window("maximize", { animate = true }),
}

hotkey{
  name = "always-on-top",
  keys = "Ctrl+Alt+a",
  action = window("toggle_topmost"),
}

hotkey{
  name = "minimize",
  keys = "Ctrl+Alt+w",
  action = window("minimize"),
}

hotkey{
  name = "focus-notepad",
  comment = "激活第一个标题包含该文本的可见窗口（始终只往前抬，不收起）",
  keys = "Ctrl+Alt+n",
  action = window("activate", { target = "Notepad", toggle = false }),
}

-- 唤起一个应用，没在运行时先把它启动起来。
--
-- `process` 匹配的是可执行文件的*文件名*（大小写无关的子串），而不是窗口标题：
-- 终端窗口的标题是里面那个 shell 打印出来的任意内容，所以 `wezterm` 也会匹配
-- `wezterm-gui.exe` 的窗口，而 `wezterm.exe` 本身（一个没有窗口的启动器）
-- 永远不会匹配。
--
-- `launch` 只在没有窗口匹配时执行。flowkeyd 随后最多等待 `wait_ms` 让新窗口出现，
-- 然后激活它；于是这只需要一个快捷键，而不是“先启动、祈祷它起来了、再激活”。
-- `{USERPROFILE}` 会从环境变量展开，因此路径不必写死。
--
-- `activate` 默认带 `toggle`：按下去时如果 WezTerm 已经在前台，就把它最小化，
-- 于是这一个键在唤起与收起之间切换（和点任务栏按钮一样）。想让它永远只往前抬，
-- 像上面的 `focus-notepad` 那样写 `toggle = false`。
-- 窗口不在你当前那张虚拟桌面上时（例如下面的 `window_rule` 把它放在第 2 张桌面）
-- 不算“已经在前台”：按下去会切到它所在的那张桌面并激活它。
hotkey{
  name = "focus-wezterm",
  comment = "Win+s 唤起 WezTerm；没在运行时先启动它。",
  keys = "Win+s",
  action = window("activate", {
    process = "wezterm",
    launch = {
      program = [[{USERPROFILE}\scoop\shims\wezterm.exe]],
      args = { "start" },
      wait_ms = 5000,
    },
  }),
}

-- 对于通过 `open`（ShellExecuteW）启动的应用也一样，它还会处理已注册的应用
-- 与文件关联。
hotkey{
  name = "focus-vscode",
  keys = "Ctrl+Alt+x",
  action = window("activate", {
    process = "Code",
    launch = { program = "code", args = { "." }, wait_ms = 5000 },
  }),
}

-- 把当前（前台）窗口挪到相邻的虚拟桌面 / 显示器。
--
--   move_prev_desktop / move_next_desktop
--       上一张 / 下一张虚拟桌面。**首尾相接**：第一张再往前是最后一张，
--       最后一张再往后是第一张。窗口在显示器上的大小/位置完全不变。
--       默认视图**不**跟着走（移动的是窗口，不是当前桌面）；带
--       `follow = true` 时搬完之后把视图也切到目标桌面并重新激活那个窗口
--       （用户跟着窗口一起过去）。
--   move_left_monitor / move_right_monitor
--       左 / 右边的显示器（按“先左后右、再上后下”的排列顺序）。虚拟桌面不变；
--       最大化窗口在新显示器上仍然最大化，普通窗口保持原有大小并居中；
--       已经在最左/最右那一块时只会写一条日志，**不循环**。
--
-- 这四个 op 都不写 `target` / `process`，所以目标是当前前台窗口；它们也不
-- 套用 `toggle`，不接受 `launch`。下面的键位只是例子（不吞系统快捷键）。
hotkey{
  name = "window-prev-desktop",
  comment = "把当前窗口移到上一张虚拟桌面（首尾相接）",
  keys = "Ctrl+Alt+1",
  action = window("move_prev_desktop"),
}

hotkey{
  name = "window-next-desktop",
  comment = "把当前窗口移到下一张虚拟桌面（首尾相接）",
  keys = "Ctrl+Alt+2",
  action = window("move_next_desktop"),
}

hotkey{
  name = "window-left-monitor",
  comment = "把当前窗口移到左边的显示器（保持最大化状态，否则保持大小并居中）",
  keys = "Ctrl+Alt+3",
  action = window("move_left_monitor"),
}

hotkey{
  name = "window-right-monitor",
  comment = "把当前窗口移到右边的显示器（没有更右的显示器时就只记一条日志）",
  keys = "Ctrl+Alt+4",
  action = window("move_right_monitor"),
}

-- `follow = true`：把窗口搬过去之后，视图也切到目标桌面，并重新激活那个窗口
-- （`Win+Ctrl+Shift+←/→` 只搬窗口，这几条会把用户一起带过去）。
-- `follow` 只能写在这两个虚拟桌面 op 上，写在其它的 op 上会被 `--check` 拒绝。
hotkey{
  name = "window-prev-desktop-follow",
  comment = "把当前窗口移到上一张虚拟桌面，并跟着切过去（首尾相接）",
  keys = "Ctrl+Alt+5",
  action = window("move_prev_desktop", { follow = true }),
}

hotkey{
  name = "window-next-desktop-follow",
  comment = "把当前窗口移到下一张虚拟桌面，并跟着切过去（首尾相接）",
  keys = "Ctrl+Alt+6",
  action = window("move_next_desktop", { follow = true }),
}

-- 虚拟桌面：按序号直达。
--
-- Windows 自己只有相邻切换（Ctrl+Win+Left/Right），按编号跳转要用 shell
-- 未公开的 `IVirtualDesktopManagerInternal`（公开的 `IVirtualDesktopManager`
-- 只能查询窗口在哪个桌面、以及把窗口移过去）。序号从 1 开始，也就是
-- Task View 里从左到右的顺序。接口的 IID 随 Windows 版本变化。
--
-- 这里用循环一次生成三条绑定：桌面数比 3 多就改上面的范围。
for i = 1, 3 do
  hotkey{
    name = "desktop-" .. i,
    comment = "Win+F1..F3 直达第 1..3 个虚拟桌面",
    keys = "Win+F" .. i,
    action = desktop(i),
  }
end

-- 剪贴板辅助。
hotkey{
  name = "copy-path",
  keys = "Ctrl+Alt+c",
  action = clipboard("set", { text = "{config_dir}" }),
}

hotkey{
  name = "clipboard-info",
  keys = "Ctrl+Alt+v",
  action = clipboard("get"),
}

-- 把剪贴板内容作为命令行参数传出去。
hotkey{
  name = "search-clipboard",
  keys = "Ctrl+Alt+b",
  action = run("cmd.exe", { "/c", "start", "https://www.bing.com/search?q={clipboard}" }),
}

-- 对讲机风格：按下时做一件事，松开时做另一件事。
hotkey{
  name = "push-to-talk",
  keys = "Ctrl+Alt+F9",
  swallow = false,
  action = send("^{c}"),
  on_release = notify("Released", "Ctrl+Alt+F9 is up"),
}

-- 只在松开时执行：把动作留在 action 里、把 trigger 改成 release 就行，
-- 这样不必用 on_release。
hotkey{
  name = "release-only",
  comment = "抬起时才粘贴：按下期间可以先做别的",
  keys = "Ctrl+Alt+F10",
  trigger = "release",
  action = send("^{v}"),
}

-- 完全没有动作的快捷键只会吞掉按键：下面这条会彻底禁用 Windows 键。
-- 需要开始菜单就把它注释掉。
-- hotkey{
--   name = "block-windows-key",
--   keys = { "LWin", "RWin" },
--   action = none(),
-- }

-- 选单（`menu`）与电源（`power`）。
--
-- `menu` 弹出一张 FluentWinUI3 的无边框圆角卡片，按条目上的单字符键
-- 直接选中它，↑/↓ + Enter 与鼠标也能选；Esc（或点到别的地方）只是把选单关掉。
-- 窗口尺寸、内边距、圆角与字号都按所在显示器的 DPI 缩放。
--
-- 选中的动作照旧在动作线程上执行（选单窗口只负责选），因此条目里
-- 可以放任何动作：`send`、`window`、`run`、`desktop`……
--
-- `power` 的取值：sleep（睡眠）/ hibernate（休眠）/ shutdown（关机）/ restart（重启）/
-- logoff（注销）/ lock（锁定）/ screen_off（关掉全部显示器，但不睡眠）。
-- 除了锁定与关屏，其余都会申请管理员权限（flowkeyd 默认就是提权运行的）；
-- 失败时会写一行日志并弹一个气泡提示，不会静悄悄地什么都不做。
--
-- `screen_off` 走的是 Windows 自己那条“屏幕超时后关屏”的路径：系统、应用和
-- 钩子都继续运行（不是睡眠），任意按键或鼠标动作都会把所有显示器重新点亮。
--
-- 下面把 Win+x 从系统的“快捷链接菜单”变成电源选单（S 睡眠、P 关机、R 重启、
-- L 锁定、O 关屏，Esc 关闭），和使用者自己按托盘菜单/开始菜单里的电源是同一回事。
-- 吞掉 Win+x 是预期的：和这里的 Win+s 取代系统搜索一样。
hotkey{
  name = "power-menu",
  comment = "Win+x：电源选单（S 睡眠 / P 关机 / R 重启 / L 锁定 / O 关屏 / Esc 关闭）",
  keys = "Win+x",
  action = menu{
    title = "电源",
    items = {
      { key = "s", label = "睡眠", hint = "Sleep", action = power("sleep") },
      { key = "p", label = "关机", hint = "Shut down", action = power("shutdown") },
      { key = "r", label = "重启", hint = "Restart", action = power("restart") },
      { key = "l", label = "锁定", hint = "Lock", action = power("lock") },
      { key = "o", label = "关闭屏幕", hint = "Screen off", action = power("screen_off") },
      -- 不写 `action`（或写 `none()`）的条目就是“把选单关掉”，和 Esc 一样。
      { label = "取消", hint = "Esc", action = none() },
    },
  },
}

-- 快捷键帮助：`help()` 弹出一张列出**当前配置里全部快捷键**的卡片，
-- 风格与上面的电源选单完全一致（无边框圆角卡片、按键徽标、按 DPI 缩放）。
--
-- 列表由配置本身生成，所以这个动作不需要任何参数。窗口里：
--   * 直接输入就筛选（和弦、`comment`/`name`、动作摘要都参与匹配）；
--   * ↑/↓、PgUp/PgDn 与鼠标滚轮滚动（滚动只滚视图，不改键盘选中项）；
--   * Enter（或双击一行）= **关掉窗口并执行那一行的动作**（等价于按一下那个
--     快捷键；重映射那一行等价于按一下源键）；
--   * 左键点一行 = 选中它并把它的按键复制到剪贴板；
--   * quit/suspend/power 这类危险动作要按两次（第一次只是等确认）；
--   * Esc 依次是「取消待确认 → 清筛选 → 关窗」（点到别的地方也会收起）。
-- 这份示例配置有几十条绑定，正好用它看看全貌；卡片顶部的标题可以换：
-- `help("我的快捷键")`，简写 `action = "help"` 等价于 `help()`。
--
-- `Win+/` 会吞掉 Windows 自己那个“表情/输入法”面板快捷键，和上面的 Win+s /
-- Win+x 是同一回事；不想吞就换一个键。
hotkey{
  name = "help",
  comment = "Win+/：列出当前所有快捷键（可输入筛选、Enter 执行）",
  keys = "Win+/",
  action = help(),
}

-- 控制类快捷键。suspend 快捷键在挂起期间仍然可用。
hotkey{
  name = "suspend-toggle",
  keys = "Ctrl+Alt+F12",
  action = suspend("toggle"),
}

hotkey{
  name = "reload",
  keys = "Ctrl+Alt+F5",
  action = reload(),
}

hotkey{
  name = "quit",
  keys = "Ctrl+Alt+F4",
  action = quit(),
}

-- =============================================================================
-- 窗口摆放规则（window_rule）
-- =============================================================================
-- 某个程序的窗口**第一次出现**时，把它放到指定的虚拟桌面 / 显示器上。
-- 触发时机只有三个：窗口第一次出现、之前断开的显示器重新接上、flowkeyd 启动时；
-- 之后不再干预（你自己移动 / 缩放窗口、取消钉住 / 取消置顶都不会被纠正）。
--
-- 如果规则**真的**把窗口搬到了另一张桌面（窗口本来不在那张桌面上），flowkeyd 会
-- 把视图也切过去并重新激活它，于是“启动它”一次就能看到它；启动与显示器重新
-- 接入那两遍只重新摆放、从不切视图（后台程序开窗不会抢你的视图）。
--
-- process / title   至少写一个：前者匹配可执行文件名（写 `wezterm` 能匹配
--                   `wezterm-gui.exe`），后者匹配窗口标题，都是大小写无关子串。
-- desktop           可选，虚拟桌面序号（1 起，Task View 从左到右）。
-- all_desktops      可选；true 把窗口钉在**所有**虚拟桌面上（Task View 里的
--                   「在所有桌面显示」），false 显式取消钉住。与 desktop 互斥。
-- topmost           可选；true 让窗口**始终在最上层**（WS_EX_TOPMOST），
--                   false 显式取消置顶。
-- monitor           可选：`2`（1 起，按显示器排列「先左后右、再上后下」）、
--                   `"primary"`、`"DISPLAY2"`（设备名，也可写全名 `\\.\DISPLAY2`）。
-- maximize          可选；**默认：写了 monitor、又没写位置 / 大小时为 true**，
--                   即铺满目标显示器的工作区（扣掉任务栏）。
-- x / y             可选，相对目标显示器工作区左上角的偏移（像素）。
-- width / height    可选，像素。maximize = true 不能与它们同时写。
-- enabled           可选，false 表示忽略这条。
--
-- 只写 desktop 时窗口的大小 / 位置保持不动（不会因为“默认最大化”而突然变大）。
-- 规则按书写顺序匹配，先写的赢。

window_rule{
  name = "wezterm-right",
  process = "wezterm",
  desktop = 2,
  monitor = 2,
}

-- 指定大小与位置：相对目标显示器工作区的左上角。不写 monitor 时默认放在
-- 窗口当前所在的那块显示器上。
window_rule{
  name = "code-primary",
  process = "code",
  monitor = "primary",
  maximize = false,
  x = 0,
  y = 0,
  width = 1280,
  height = 800,
}

-- 只按标题匹配也行（两个都给时都要满足）。
window_rule{
  name = "steam-on-second",
  title = "Steam",
  monitor = "DISPLAY2",
}

-- 钉在所有虚拟桌面 + 始终在最上层：适合音乐播放器 / 便签 / 悬浮工具这类
-- “切到哪张桌面都想看得见”的窗口。两者都不算几何，所以窗口的大小 / 位置不变。
window_rule{
  name = "music-everywhere",
  process = "spotify",
  all_desktops = true,
  topmost = true,
}

-- =============================================================================
-- 按程序写在一起（app）
-- =============================================================================
-- 上面两节是把「唤起某个程序的快捷键」与「这个程序的窗口摆放规则」分开写的；
-- 一个程序只用一次还行，程序多了就会把 process 写两遍（动作里一次、规则里一次），
-- 而且改程序名要改两处。app{} 把这几半写到一起：
--
--   name         可选，日志 / --list / 帮助窗口里的名字；不写用 process，再退到 title。
--   process      可执行文件名子串（与 window_rule / window 动作的 process 一致）。
--   title        窗口标题子串；与 process 至少写一个。
--   launch       可选，这个程序怎么启动（字段与 window 动作的 launch 完全一样：
--                program / args / cwd / show / shell / env / wait_ms）。里面的 window
--                动作自动继承它，于是只写 window("activate") 就够了；想给某一条
--                快捷键换等待时间就写 window("activate", { wait_ms = 5000 })。
--   window       可选，一条 window_rule 的全部字段（desktop / monitor / maximize …），
--                process / title / name 自动继承，不用重复写。
--   hotkeys      可选，一组 hotkey（字段与 hotkey{} 完全相同）；其中的 window 动作
--                自动继承 app 的 process / title / launch（显式写的优先；动作自己的
--                launch 逐字段覆盖 app 的），于是不再需要手写 process = "..."。
--   enabled      可选，false 表示整条 app（规则 + 快捷键）都忽略。
--
-- 展开出来的 hotkey / window_rule 排在全局条目之后（同一次注册顺序的最后），
-- 先注册先匹配的规则不变。全局的 hotkey{} / window_rule{} 仍然保留：
-- 没有窗口规则的快捷键、没有快捷键的规则，照旧单独写。
--
-- app 里**只有一个 hotkey** 时，它的默认名字用 app 的名字；多个时用第一个和弦，
-- 免得一个 app 下的几条绑定重名。

-- 启动参数与窗口规则都写在 app 上，动作只剩 window("activate")。
app{
  process = "wps",
  name = "wps",
  launch = {
    program = [[C:\tools\ksolaunch.exe]],
    args = { "/prometheus", "/fromksolaunch" },
    wait_ms = 10000,
  },
  window = { desktop = 3, monitor = 2 },
  hotkeys = {
    {
      comment = "Win+3：激活 WPS Office（没有就启动）",
      keys = "Win+3",
      -- launch 整份继承；process 也自动继承 app 的 "wps"。
      action = window("activate"),
    },
  },
}

-- 不写 name 也可以：规则与默认的绑定名都用 process。
app{
  process = "obs64",
  window = { monitor = "primary", maximize = false, width = 1280, height = 800 },
}

-- 只按标题匹配的程序（比如没固定可执行文件名的游戏启动器）：title 同样会传给
-- 规则与 hotkey 里的 window 动作。动作里只写 wait_ms 时，其余启动参数（这里的
-- program）从 app 的 launch 继承。
app{
  title = "Epic Games",
  launch = { program = [[C:\tools\epic.exe]] },
  window = { monitor = "DISPLAY2" },
  hotkeys = {
    { keys = "Ctrl+Alt+k", action = window("activate", { wait_ms = 8000 }) },
  },
}

-- =============================================================================
-- 重映射
-- =============================================================================
-- `from` 是按键或和弦，`to` 是按键名（类似 AutoHotkey 的 `CapsLock::Esc`）
-- 或一个发送脚本。mode = "hold"（默认）在按住 `from` 期间一直按住目标；
-- mode = "tap" 每次按下只触发一次目标。

remap{
  name = "capslock-to-escape",
  from = "CapsLock",
  to = "Esc",
}

-- 把右侧 Ctrl 也当成 Ctrl（这种用法只有 hold 模式才有意义）。
remap{
  name = "right-ctrl-as-ctrl",
  from = "RCtrl",
  to = "Ctrl",
  mode = "hold",
}

-- 把一个死键变成有用的键。
remap{
  name = "menu-key-to-enter",
  from = "Apps",
  to = "Enter",
}

-- 重映射里的 {Sleep} 会被忽略（--check 会警告）：注入必须和物理按键流
-- 保持同样的顺序，钩子回调不能停在那里等。
